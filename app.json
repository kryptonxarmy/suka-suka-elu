{
  "expo": {
    "name": "berrycare",
    "slug": "berrycare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Stroberi-splash.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/Stroberi-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF0E6"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true,
      "jsEngine": "hermes"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/ada/imagesptiv/imagese-ic/imageson.png",
        "backgroundColor": "#ffffff"
      },
      "jsEngine": "hermes"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "expo": {
            "name": "BerryCare",
            "slug": "berrycare",
            "version": "1.0.0",
            "orientation": "portrait",
            "backgroundColor": "#FAF0E6", 
            "splash": {
              "image": "assets/images/Stroberi-splash.png",
              "resizeMode": "contain",
              "backgroundColor": "#FAF0E6", 
              "imageResizeMode": "contain"
            }
          }
        }        
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow berrycare to access your camera",
          "microphonePermission": "Allow berrycare to access your microphone",
          "recordAudioAndroid": true
        }
      ],
      "expo-media-library",
      "expo-image-picker",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}